# Print files must retain byte-exact hashes, even when their PDF streams use ASCII85.
*.pdf binary
*.webp binary
*.png binary
*.jpg binary
*.ttf binary
*.woff2 binary
*.csv text eol=lf

# Preserve the original whitespace in the official USNO API responses.
data/lunar/sources/usno-*.json -whitespace

# RFC 5545 calendars must keep CRLF and exact UTF-8 folding across checkouts.
site/assets/holiday-phase2-ics/*.ics binary
public/assets/holiday-phase2-ics/*.ics binary
site/assets/holiday-ics/*.ics binary
public/assets/holiday-ics/*.ics binary
site/assets/holiday-guides-ics/*.ics binary
public/assets/holiday-guides-ics/*.ics binary

# Seasonal calendar exports require literal RFC 5545 CRLF bytes.
site/assets/seasons-ics/*.ics binary
public/assets/seasons-ics/*.ics binary

# Name-day all-day calendars retain RFC 5545 CRLF and UTF-8 byte folding.
site/assets/namedays-ics/*.ics binary
public/assets/namedays-ics/*.ics binary
