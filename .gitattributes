# Print files must retain byte-exact hashes, even when their PDF streams use ASCII85.
*.pdf binary
*.webp binary
*.png binary
*.jpg binary
*.ttf binary
*.woff2 binary
*.csv text eol=lf

# Preserve the original whitespace in the official USNO API responses.
data/lunar/sources/usno-*.json -whitespace

# RFC 5545 calendars must keep CRLF and exact UTF-8 folding across checkouts.
site/assets/holiday-phase2-ics/*.ics binary
public/assets/holiday-phase2-ics/*.ics binary
